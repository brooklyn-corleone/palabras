          "rows": [
            ["yo", "salgo", "soy", "tengo", "traigo"],
            ["tú", "sales", "eres", "tienes", "traes"],
            ["él, ella, usted", "sale", "es", "tiene", "trae"],
            ["nosotros/as", "salimos", "somos", "tenemos", "traemos"],
            ["vosotros/as", "salís", "sois", "tenéis", "traéis"],
            ["ellos/as, ustedes", "salen", "son", "tienen", "traen"]
