    {
      "id": "alfabeto",
      "group": "alfabeto",
      "title": "Испанский алфавит",
      "blocks": [
        {
          "kind": "list",
          "items": [
            "A a — a",
            "B b — be",
            "C c — ce",
            "D d — de",
            "E e — e",
            "F f — efe",
            "G g — ge",
            "H h — hache",
            "I i — i",
            "J j — jota",
            "K k — ka",
            "L l — ele",
            "M m — eme",
            "N n — ene",
            "Ñ ñ — eñe",
            "O o — o",
            "P p — pe",
