              "vosotros/as",
              "habláis",
              "coméis",
              "vivís"
            ],
            [
              "ellos/as, ustedes",
              "hablan",
              "comen",
              "viven"
            ]
          ]
        },
        {
          "kind": "text",
          "body": "hablar — говорить, comer — есть, vivir — жить. Отбрасываешь -ar, -er или -ir и добавляешь окончание. У -er и -ir всё совпадает, кроме nosotros и vosotros."
        }
      ]
